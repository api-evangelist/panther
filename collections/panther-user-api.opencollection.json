{
  "opencollection": "1.0.0",
  "info": {
    "name": "Panther REST alert user API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "user",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{api_host}/users",
            "params": [
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "Pagination token"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of results to return"
              },
              {
                "name": "contains",
                "value": "",
                "type": "query",
                "description": "Search name and email fields in a case-insensitive fashion"
              },
              {
                "name": "email",
                "value": "",
                "type": "query",
                "description": "An exact match of a user's email to return. If provided all other parameters are ignored"
              },
              {
                "name": "id",
                "value": "",
                "type": "query",
                "description": "Set of IDS to return"
              },
              {
                "name": "ids",
                "value": "",
                "type": "query",
                "description": "A comma delimited list of IDs"
              },
              {
                "name": "include-deactivated",
                "value": "",
                "type": "query",
                "description": "Include deactivated users"
              },
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "Show only users with this Cognito status"
              }
            ]
          },
          "docs": "List users"
        },
        {
          "info": {
            "name": "Create a user",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{api_host}/users",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a user"
        },
        {
          "info": {
            "name": "Get a user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{api_host}/users/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID of the user"
              }
            ]
          },
          "docs": "Get a user"
        },
        {
          "info": {
            "name": "Update a user",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{api_host}/users/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID of the user"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a user"
        },
        {
          "info": {
            "name": "Delete a user",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{api_host}/users/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID of the user"
              }
            ]
          },
          "docs": "Delete a user"
        }
      ]
    }
  ],
  "bundled": true
}