{
  "opencollection": "1.0.0",
  "info": {
    "name": "Panther REST alert data model API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "data model",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "list data models",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{api_host}/data-models",
            "params": [
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "the pagination token"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "the maximum results to return"
              }
            ]
          },
          "docs": "list data models"
        },
        {
          "info": {
            "name": "create data model",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{api_host}/data-models",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "create data model"
        },
        {
          "info": {
            "name": "get data model",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{api_host}/data-models/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID of the data model to fetch"
              }
            ]
          },
          "docs": "get data model"
        },
        {
          "info": {
            "name": "put data model",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{api_host}/data-models/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "the id of the data model"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "put creates or updates a data model"
        },
        {
          "info": {
            "name": "delete data model",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{api_host}/data-models/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID of the data model to delete"
              }
            ]
          },
          "docs": "delete data model"
        }
      ]
    }
  ],
  "bundled": true
}