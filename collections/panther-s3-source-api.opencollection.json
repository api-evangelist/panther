{
  "opencollection": "1.0.0",
  "info": {
    "name": "Panther REST alert s3 source API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "s3 source",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "create s3 source",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{api_host}/log-sources/s3",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "create s3 source"
        },
        {
          "info": {
            "name": "get s3 source",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{api_host}/log-sources/s3/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID of the S3 source to fetch"
              }
            ]
          },
          "docs": "get s3 source"
        },
        {
          "info": {
            "name": "put s3 source",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{api_host}/log-sources/s3/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID of the S3 source to update"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "put s3 source"
        },
        {
          "info": {
            "name": "delete s3 source",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{api_host}/log-sources/s3/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID of the S3 source to delete"
              }
            ]
          },
          "docs": "delete s3 source"
        }
      ]
    }
  ],
  "bundled": true
}